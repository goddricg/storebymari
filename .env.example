# Runtime
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000
NEXT_PUBLIC_SITE_ID=main
NEXT_PUBLIC_BASE_URL=https://storebymari.com

# MySQL (create a new least-privilege database user in Plesk)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Session signing (generate a new value for this deployment)
JWT_SECRET=
PRIMARY_SUPER_ADMIN_EMAIL=
SELLER_EMAIL=

# Optional email notifications
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESTOCK_ALERT_RECIPIENT=

# Optional LINE integration
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Optional Firebase integration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_REALTIME_ENABLED=false

# Optional AI and payment providers
GEMINI_API_KEY=
MIMI_AGENT_MODEL=gemini-flash-lite-latest
RDCW_API_ENDPOINT=https://suba.rdcw.co.th/v2/inquiry
RDCW_API_CLIENT_ID=
RDCW_API_CLIENT_SECRET=
SLIP2GO_API_ENDPOINT=
SLIP2GO_API_SECRET=
SLIP2GO_SECRET_KEY=

# Optional web push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional protected endpoints
CRON_SECRET=
MAIN_SITE_SYNC_SECRET=
MCP_SECRET_KEY=
REVALIDATE_SECRET=
